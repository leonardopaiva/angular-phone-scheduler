// include default
// "src/**/*.d.ts"
// para o compodoc funcionar deve-se alterar o include para
// "src/**/*.ts"
// porem fazer apenas para gerar a documentar e depois desfazer para evitar 
// erros de compilacao no ng serve e outros comandos.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ]
}

